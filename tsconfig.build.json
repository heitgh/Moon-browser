{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "ui/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "release",
    "coverage",
    "tests",
    "src",
    "sunshine"
  ]
}
